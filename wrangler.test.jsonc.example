{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anime-english-mvp",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-05",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "env": {
    "test": {
      "name": "anime-english-mvp-test",
      "vars": {
        "AI_GATEWAY_URL": "https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions",
        "AI_MODEL": "qwen-plus",
        "AI_VISION_MODEL": "qwen3-vl-flash",
        "TEST_LOCKDOWN": "true",
        "TEST_ALLOWED_EMAIL": "2270110783@qq.com"
      },
      "secrets": {
        "required": [
          "AI_GATEWAY_TOKEN"
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "english-ai-test",
          "database_id": "REPLACE_WITH_TEST_D1_ID",
          "migrations_dir": "migrations"
        }
      ],
      "observability": {
        "enabled": true,
        "traces": {
          "enabled": true
        }
      },
      "workers_dev": true,
      "preview_urls": false
    }
  }
}
